  "findings": [
    {
      "severity": "high",
      "element": "C.1.7",
      "finding": "The code set is correct but NI is exposed as an ordinary choice. ICH permits it only for a narrow E2B(R2)-retransmission compatibility case.",
      "requiredRootFix": "Hide NI for normal/manual R3 entry and validate it using reliable R2-origin provenance. Preserve it only for qualifying retransmitted legacy cases."
    },
    {
      "severity": "high",
      "element": "C.2.r.3",
      "finding": "NullFlavor is forbidden by the latest official IG/Q&A, but every repository layer models and accepts four NullFlavors.",
      "requiredRootFix": "Remove the companion nullFlavor from registry, generated contracts, UI, API/model/DB, and XML import/export for reporter country. Do not confuse this with C.5.1.r.2 study registration country, where ASKU/NASK remain allowed."
    },
    {
      "severity": "high",
      "element": "D.9.3",
      "finding": "MSK is not allowed; the repository allows it. The XML exporter also falls back to NI, which is likewise forbidden.",
      "requiredRootFix": "Change the canonical set to ASKU/NASK/UNK, propagate it through contracts/UI/DB, reject MSK/NI on import, and remove the exporter NI fallback."
    },
    {
      "severity": "high",
      "element": "F.r.3.2",
      "finding": "The code values match but the data model is semantically wrong. NINF/PINF qualify an open interval bound, not a missing whole test-result value.",
      "requiredRootFix": "Model numeric interval value/bounds/inclusivity and serialize xsi:type=IVL_PQ with low/high nullFlavor bounds as shown in IG/Q&A; remove the whole-field NullFlavor selector and top-level value@nullFlavor persistence."
    }
  ],
  "ambiguities": [
    {
      "element": "D.8.r.1",
      "note": "NA and UNK have distinct circumstances: NA for no previous exposure; UNK when the section is otherwise used but the drug name is unavailable."
    }
  ]
}
